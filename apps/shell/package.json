{
  "name": "@genoffice/shell",
  "productName": "GenOffice Trio",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Shell principal que hospeda docs, sheets e pdf em abas",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/ui": "*",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {

    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.genoffice.trio",
    "productName": "GenOffice Trio",
    "electronVersion": "43.3.0",
    "artifactName": "GenOffice-Trio-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
